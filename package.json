{
  "name": "dsh-pi-auth-bridge",
  "version": "0.4.0",
  "description": "dsh plugin: bridge local pi (Pi coding agent) auth into dsh LLM routes, in-memory only",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./typert": {
      "types": "./dist/typert/host.d.ts",
      "default": "./dist/typert/host.js"
    },
    "./remote": {
      "types": "./dist/typert/remote-client.d.ts",
      "default": "./dist/typert/remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "^0.84.3",
    "undici": "^8.10.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.6-alpha.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-gateway": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-attachment": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.6-alpha.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
